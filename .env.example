# Tracekit environment configuration example
# Copy this file to .env and adjust values as needed.
# Do NOT commit real secrets to version control.

# Base directory for tracekit data (default: ~/.tracellm)
# TRACELLM_HOME=~/.tracellm

# SQLite database path (overrides TRACELLM_HOME/traces.db if set)
# TRACEKIT_DB_PATH=~/.tracellm/traces.db

# Deployment environment: development, staging, production, or a custom value
# TRACEKIT_ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR
# TRACEKIT_LOG_LEVEL=INFO

# Automatic flushing
# TRACEKIT_AUTO_FLUSH=false
# TRACEKIT_FLUSH_INTERVAL_SECONDS=30
# TRACEKIT_MAX_SPANS_IN_MEMORY=1000

# Default trace sampling rate (0.0 - 1.0)
# TRACEKIT_SAMPLING_RATE=1.0

# Token estimation jitter for LLM spans without provider usage (0.0 - 1.0)
# TRACEKIT_TOKEN_ESTIMATION_JITTER=0.10

# Service name for OTLP resource attributes
# TRACEKIT_SERVICE_NAME=tracekit

# OTLP HTTP endpoint for trace export (default: localhost collector)
# OTLP_ENDPOINT=http://localhost:4318/v1/traces

# OTLP headers as comma-separated key=value pairs (never commit real secrets)
# OTLP_HEADERS=Authorization=Bearer <token>,X-Custom-Header=value

# Optional real-time WebSocket streaming (disabled by default)
# Requires: pip install -e ".[streaming]"
# TRACEKIT_STREAM_ENABLED=false
# TRACEKIT_STREAM_HOST=127.0.0.1
# TRACEKIT_STREAM_PORT=8765

# Optional webhook delivery (disabled unless transport is configured)
# Requires: pip install -e ".[webhook]"
# TRACEKIT_WEBHOOK_ENDPOINT=https://example.com/tracekit-webhook
